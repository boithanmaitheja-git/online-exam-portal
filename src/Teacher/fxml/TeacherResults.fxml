<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="Teacher.TeacherResults"
            prefWidth="720" prefHeight="420" style="-fx-background-color:#fff;">
    <VBox layoutX="20" layoutY="20" spacing="10" style="-fx-padding:12;">
        <Label text="Students' Results (Your Exams)" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
        <TableView fx:id="resultTable" prefHeight="340" prefWidth="680">
            <columns>
                <TableColumn fx:id="studentNameCol" text="Student" prefWidth="220"/>
                <TableColumn fx:id="examTitleCol" text="Exam" prefWidth="300"/>
                <TableColumn fx:id="percentageCol" text="Percentage" prefWidth="90"/>
                <TableColumn fx:id="gradeCol" text="Grade" prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
