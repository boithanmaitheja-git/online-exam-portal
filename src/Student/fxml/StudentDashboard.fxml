<?xml version="1.0" encoding="UTF-8" ?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="20" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Student.StudentDashboard"
      style="-fx-padding: 30px; -fx-background-color: #ffffff;">

    <Label fx:id="welcomeLabel"
           text="Welcome Student"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <Label text="Available Exams"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <ScrollPane fitToWidth="true" style="-fx-background-color:#ffffff;">
        <VBox fx:id="examListBox" spacing="10"
              style="-fx-padding: 10;" />
    </ScrollPane>

</VBox>
