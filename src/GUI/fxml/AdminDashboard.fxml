<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.AdminDashboard"
            prefWidth="700" prefHeight="450" style="-fx-background-color: #fdebd0;">
    
    <VBox alignment="CENTER" spacing="20" layoutX="150" layoutY="50">
        <Label text="Welcome, Admin 👑"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #6c3483;" />

        <Button text="View Teachers" fx:id="viewTeachersBtn"
                style="-fx-background-color: #5dade2; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 220;" />

        <Button text="View Students" fx:id="viewStudentsBtn"
                style="-fx-background-color: #48c9b0; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 220;" />

        <Button text="View Results" fx:id="viewResultsBtn"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 220;" />

        <Button text="Logout" fx:id="logoutBtn"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-pref-width: 220;" />
    </VBox>
</AnchorPane>
