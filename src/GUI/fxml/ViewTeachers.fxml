<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.ViewTeachers"
            prefWidth="700" prefHeight="400" style="-fx-background-color: #f8f9f9;">
    
    <VBox spacing="10" layoutX="25" layoutY="25" prefWidth="650" prefHeight="350">
        <Label text="👩‍🏫 Teachers List" 
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        
        <TableView fx:id="teacherTable" prefHeight="320" prefWidth="650">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="80"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="180"/>
                <TableColumn fx:id="usernameCol" text="Username" prefWidth="120"/>
                <TableColumn fx:id="deptCol" text="Department" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
